{
  "name": "submission-standout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:showcase": "tsc -b && VITE_SHOWCASE_ONLY=1 vite build --base=/submission_standout/ --outDir dist-showcase",
    "test": "uv run pytest -q",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "access": "uv run python -m backend.access"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
